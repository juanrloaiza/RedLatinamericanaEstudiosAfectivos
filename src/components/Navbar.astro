---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getPagesTitlesForLanguage } from "../../lib/directus";
import LangSwitcher from "./LangSwitcher.astro";

const lang = Astro.currentLocale || "es";

const data = await getPagesTitlesForLanguage(lang);
---

<div class="flex items-center">
    <div class="flex grow gap-x-4 justify-center">
        {
            data.map((item) => {
                return (
                    <a href={getRelativeLocaleUrl(lang, item.slug)}>
                        {item.title}
                    </a>
                );
            })
        }
    </div>
    <div>
        <LangSwitcher />
    </div>
</div>
