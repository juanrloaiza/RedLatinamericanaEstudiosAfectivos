---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getStaticPathsWithMultilanguageSlug } from "../../i18n/utils";
import {
    directus,
    getDirectusLocaleCode,
    getTranslatedPage,
} from "../../../lib/directus";
import { readItems } from "@directus/sdk";

export const getStaticPaths = await getStaticPathsWithMultilanguageSlug(
    "members",
    "members",
);

interface Member {
    name: string;
    last_name: string;
    institution: string;
    website: string;
    country: number;
    discipline: { id: number };
}

const { lang } = Astro.props;

const content = await directus.request<[Member]>(
    readItems("affiliates", {
        fields: [
            "name",
            "last_name",
            "institution",
            "website",
            "country",
            "discipline.id",
        ],
        deep: {
            translations: {
                _filter: {
                    languages_code: {
                        _eq: getDirectusLocaleCode(lang),
                    },
                },
            },
        },
        sort: ["last_name"]
    }),
);
const countryDict: Record<string, string> = {};
(
    await directus.request(
        readItems("countries", {
            fields: ["id", "translations.name"],
            deep: {
                translations: {
                    _filter: {
                        languages_code: {
                            _eq: getDirectusLocaleCode(lang),
                        },
                    },
                },
            },
        }),
    )
).forEach((country) => {
    countryDict[country.id] = country.translations[0].name;
});

const disciplineDict: Record<string, string> = {};
(
    await directus.request(
        readItems("disciplines", {
            fields: ["id", "translations.name"],
            deep: {
                translations: {
                    _filter: {
                        languages_code: {
                            _eq: getDirectusLocaleCode(lang),
                        },
                    },
                },
            },
        }),
    )
).forEach((discipline) => {
    disciplineDict[discipline.id] = discipline.translations[0].name;
});

const title = (await getTranslatedPage("members", lang)).title;

---

<BaseLayout title={title}>
    <div class="lg:grid gap-10 grid-cols-3">
        {
            content.map((member) => (
                <div class="mb-6 lg:mb-0">
                    <div class="text-xl">
                        {member.name} {member.last_name}
                    </div>
                    {member.institution} <br />
                    {countryDict[member.country]} <br />
                 
                    <div class="inline-block py-1 px-2 text-xs bg-gray-300 rounded">    
                        {disciplineDict[member.discipline.id]}
                    </div>
                            
                    {member.website && (
                        <a class="inline-block text-xs py-1 px-2 border-1 rounded" href={member.website}>Website</a> <br />
                    )}
                </div>
            ))
        }
    </div>
</BaseLayout>
