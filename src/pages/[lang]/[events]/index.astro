---
import { readItems } from "@directus/sdk";
import { directus, getDirectusLocaleCode, getTranslatedPage } from "../../../../lib/directus";
import { getStaticPathsWithMultilanguageSlug } from "../../../i18n/utils";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getRelativeLocaleUrl } from "astro:i18n";

export const getStaticPaths = await getStaticPathsWithMultilanguageSlug(
    "events",
    "events",
);

interface Event {
    id: number,
    translations: { title: string; description: string }[];
    dates: {
        start_date: string;
        end_date: string;
    }[];
    online: boolean;
}

const { lang } = Astro.props;

const slug = (await getTranslatedPage("events", lang)).slug;


const content = await directus.request<[Event]>(
    readItems("events", {
        fields: [
            "id",
            "translations.title",
            "translations.description",
            "dates",
            "online",
        ],
        deep: {
            translations: {
                _filter: {
                    languages_code: {
                        _eq: getDirectusLocaleCode(lang),
                    },
                },
            },
        },
        sort: ["-dates"],
    }),
);
---

<BaseLayout>
    {
        content.map((event) => {
            return (
                <a class="block mb-6" href=`${getRelativeLocaleUrl(lang, slug)}${event.id}`>
                    <div>{event.dates[0].start_date}</div>
                    {event.dates[0].start_date != event.dates[0].end_date &&
                        event.dates[0].end_date}
                    <h3 class="text-2xl">{event.translations[0].title}</h3>
                </a>
            );
        })
    }
</BaseLayout>
