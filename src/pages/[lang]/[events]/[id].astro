---
import { readItems } from "@directus/sdk";
import {
    directus,
    getDirectusLocaleCode,
    getTranslatedPage,
} from "../../../../lib/directus";
import { getAvailableLanguages } from "../../../i18n/ui";
import BaseLayout from "../../../layouts/BaseLayout.astro";

interface Event {
    id: number;
    translations: { title: string; description: string }[];
    dates: {
        start_date: string;
        end_date: string;
    }[];
    online: boolean;
}

export async function getStaticPaths() {
    const languages = getAvailableLanguages();

    const allPaths = await Promise.all(
        languages.map(async (lang) => {
            const content = await directus.request<Event[]>(
                readItems("events", {
                    fields: [
                        "id",
                        "translations.title",
                        "translations.description",
                        "dates",
                        "online",
                    ],
                    deep: {
                        translations: {
                            _filter: {
                                languages_code: {
                                    _eq: getDirectusLocaleCode(lang),
                                },
                            },
                        },
                    },
                    sort: ["id"],
                }),
            );

            const eventsSlug = (await getTranslatedPage("events", lang)).slug;

            return content.map((event) => ({
                params: {
                    lang,
                    events: eventsSlug,
                    id: event.id,
                },
                props: { event, lang },
            }));
        }),
    );

    return allPaths.flat();
}

const { event } = Astro.props;
---

<BaseLayout>
    <div>{event.dates[0].start_date}</div>
    {
        event.dates[0].start_date != event.dates[0].end_date &&
            event.dates[0].end_date
    }
    <h3 class="text-2xl">{event.translations[0].title}</h3>
    <div class="" set:html={event.translations[0].description} />
</BaseLayout>
